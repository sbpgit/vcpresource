{
    "_version": "1.59.0",
    "sap.app": {
        "id": "vcpapp.vcplineapps",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
           "version": "2512.01.01"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "@sap/generator-fiori:basic",
            "version": "1.12.3",
            "toolsId": "c51e5db4-74b4-4457-8fd7-5c6d68195a68"
        },
        "dataSources": {
            "mainService": {
                "uri": "/v2/catalog/",
                "type": "OData",
                "settings": {
                    "annotations": [],
                    "localUri": "localService/metadata.xml",
                    "odataVersion": "2.0"
                }
            }
        },
        "crossNavigation": {
            "inbounds": {
                "locprod-display": {
                    "semanticObject": "lineapp",
                    "icon": "sap-icon://horizontal-bar-chart",
                    "action": "display",
                    "title": "{{flpTitle}}",
                    "signature": {
                        "parameters": {},
                        "additionalParameters": "allowed"
                    }
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "sap-icon://horizontal-bar-chart",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": false,
        "dependencies": {
            "minUI5Version": "1.143.2",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.f": {},
                "sap.suite.ui.generic.template": {},
                "sap.ui.comp": {},
                "sap.ui.generic.app": {},
                "sap.ui.table": {},
                "sap.ushell": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "vcpapp.vcplineapps.i18n.i18n"
                }
            },
            "oGModel": {
                "type": "sap.ui.model.json.JSONModel",
                "settings": {
                    "defaultBindingMode": "TwoWay"
                },
                "preload": true
            },
            "BModel": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true,
                    "groupId": "$direct"
                }
            }
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "viewType": "XML",
                "async": true,
                "viewPath": "vcpapp.vcplineapps.view",
                "controlAggregation": "pages",
                "controlId": "app",
                "clearControlAggregation": false
            },
            "routes": [
                {
                    "name": "RouteHome",
                    "pattern": ":?query:",
                    "target": [
                        "TargetHome"
                    ]
                },
                {
                    "name": "Detail",
                    "pattern": "Detail{LOCATION_ID}/{LINE_ID}",
                    "target": [
                        "Detail"
                    ]
                },
                {
                    "name": "Capacity",
                    "pattern": "Detail{LOCATION_ID}/{LINE_ID}",
                    "target": [
                        "Capacity"
                    ]
                }
            ],
            "targets": {
                "TargetHome": {
                    "viewType": "XML",
                    "transition": "slide",
                    "clearControlAggregation": false,
                    "viewId": "App",
                    "viewName": "Home"
                },
                "Detail": {
                    "viewType": "XML",
                    "transition": "slide",
                    "controlAggregation": "detailView",
                    "viewId": "App",
                    "viewName": "Detail"
                },
                "Capacity": {
                    "viewType": "XML",
                    "transition": "slide",
                    "controlAggregation": "ProfileView",
                    "viewId": "App",
                    "viewName": "Capacity"
                }
            }
        },
        "rootView": {
            "viewName": "vcpapp.vcplineapps.view.App",
            "type": "XML",
            "async": true,
            "id": "App"
        }
    },
    "sap.cloud": {
        "public": true,
        "service": "vcpresource"
    },
    "sap.platform.cf": {
        "oAuthScopes": [
            "$XSAPPNAME.User"
        ],
        "ui5VersionNumber": "1.143.2"
    }
}
