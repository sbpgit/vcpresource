<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog contentWidth="400px" showHeader="false">
    <Table id="idColumnTableRS" items="{/}"> 
    <columns>
    <Column >
    <Text text="Column"/>
    </Column>
    <Column >
    <Text text="ID/ Description"></Text>
    </Column>
    </columns>
    <items>
    <ColumnListItem >
    <Text text="{columnName}"/>
    <Select >
   <core:Item key="ID" text="ID"></core:Item>
   <core:Item key="Des" text="Description"></core:Item>   
    </Select>    
    </ColumnListItem>
    </items>
    </Table>
    <beginButton>
    <Button text="Save" press="onPressSaveColumnHide"/>
    </beginButton>
   <endButton>       
    <Button text="Cancel" press="onPressCancleColunHide"/>
   </endButton>
    </Dialog>
</core:FragmentDefinition>