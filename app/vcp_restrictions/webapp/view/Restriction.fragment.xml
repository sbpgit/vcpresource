<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified">
    <Dialog id="idRestrictionRS" title="" contentWidth="450px" titleAlignment="Center">
        <VBox class="sapUiSmallMargin">
            <f:SimpleForm id="SimpleFormToolbarRS" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="4" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false">
                <f:content>
                    <Label text="{i18n>loc}"/>
                    <Input id="idlocRS" value="" placeholder="Manufacturing Location" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="handleValueHelp"/>
                    <Label text="{i18n>lineid}"/>
                    <Input id="idLineRS" value="" placeholder="Line ID" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="handleValueHelp"/>
                    <Label text="{i18n>restriction}"/>
                    <Input id="idRestRS" value="" liveChange="RestChange" tooltip="Length cannot be more than 30 characters" maxLength="30" placeholder="Length cannot be more than 30 characters" />
                    <Label text="{i18n>restdesc}"/>
                    <Input id="idRestDescRS" value="" maxLength="30" tooltip="Length cannot be more than 30 characters" placeholder="Length cannot be more than 30 characters"/>
                      <!-- <Label text="{i18n>rtrQty}"/>
                    <Input id="idRestQty" value="" liveChange="NumbersOnly" /> -->
                    <Label text="{i18n>fromtodates}"/>
                    <DateRangeSelection id="idDateRangeRS" delimiter="To" dateValue="" secondDateValue="" valueFormat="MM-dd-yyyy"
							displayFormat="MM-dd-yyyy" change="handleDateChange" maxDate=""/>

                </f:content>
            </f:SimpleForm>

        </VBox>
        <buttons>
            <Button type='Ghost' text="{i18n>save}" id="btnSaveRest" visible="false" press="onSaveRest"></Button>
            <Button type='Reject' text="{i18n>close}" press="onCloseRest"></Button>
        </buttons>
    </Dialog>
</core:FragmentDefinition>