            <!-- <List id="resListRS"  items="{ path : '/results', sorter : { path : 'LOCATION_ID'} }" mode="SingleSelectMaster" noDataText="No Data" selectionChange="onhandlePress">
                <items>
                    <ObjectListItem press="onhandlePress" title="{LOCATION_ID}" number="{LINE_ID}">
