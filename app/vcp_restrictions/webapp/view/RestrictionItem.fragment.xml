                    <Label />
                    <Input id="idClassnoRS" value="" visible="false"/>
                    <Input id="idCharnoRS" value="" visible="false"/>
                    <Input id="idCharvalnoRS" value="" visible="false"/>
                    
                    

                </f:content>
            </f:SimpleForm>

        </VBox>
