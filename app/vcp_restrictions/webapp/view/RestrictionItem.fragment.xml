        <VBox class="sapUiSmallMargin">
            <f:SimpleForm id="SimpleFormToolbaritemRS" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="4" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="1" columnsM="1" singleContainerFullSize="false">
                <f:content>
                    <Label text="{i18n>restriction}"/>
                    <Input id="idrestRS" value="{oGModel>/Restriction}" editable="false"/>
                     <Label text="{i18n>counter}"/>
                    	<StepInput
						value="1"
						min="1"
                        width="100px"
						step="1" id="stepInputRS" change="onCounterChange"
                        />
                    <Label text="Class Name"/>
                    <Input id="idClassnameRS" value=""  placeholder="Class Name" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="handleValueHelp"/>
                    <Label text="Characteristic Name"/>
                    <Input id="idCharnameRS" value=""  placeholder="Characteristic Name" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="handleValueHelp"/>
                    <Label text="{i18n>odcond}"/>
                    <Select id="idODcondRS"  selectedKey="EQ" class="buttonDesktop">
							<core:ListItem key="EQ" text="EQ"/>
							<core:ListItem key="NE" text="NE"/>
						</Select>
                    
                    <Label text="Characteristic Value"/>
                    <Input id="idCharvalRS" value=""  placeholder="Characteristic Value" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="handleValueHelp"/>

                     <Label text="Capacity Consumption Unit"/>
                    <Input id="idQuan" value="" liveChange="onQuantityChange"  type="Number"/>
                    
                    <!-- <Label text="{i18n>charcounter}"/>
                    <Input id="idcharcounter" value="" placeholder="{i18n>charcounter}" type="Number"/>
                    
                    

                    <Label text="{i18n>rowid}"/>
