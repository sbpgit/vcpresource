{
  "_version": "1.58.0",
  "sap.app": {
    "id": "vcpapp.vcpcprestrictionsavail",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
       "version": "2512.01.01"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.11.2",
      "toolsId": "7b5899ae-3072-4f3c-8f0a-1aad369be0b3"
    },
    "dataSources": {
      "mainService": {
        "uri": "/v2/catalog/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "RestriCapacity-display": {
          "semanticObject": "RestriCapacity",
          "icon": "sap-icon://measuring-point",
          "action": "display",
          "title": "{{flpTitle}}",
          "subTitle": "{{flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://measuring-point",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.143.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.suite.ui.generic.template": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.ui.table": {},
        "sap.ushell": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "vcpapp.vcpcprestrictionsavail.i18n.i18n"
        }
      },
      "BModel": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$direct"
        }
      },
      "oGModel": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {
            "defaultBindingMode": "TwoWay"
        },
        "preload": true
    }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "vcpapp.vcpcprestrictionsavail.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "RouteRestrictions",
          "pattern": ":?query:",
          "target": [
            "TargetRestrictions"
          ]
        }
      ],
      "targets": {
        "TargetRestrictions": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "Restrictions",
          "viewName": "Restrictions"
        }
      }
    },
    "rootView": {
      "viewName": "vcpapp.vcpcprestrictionsavail.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "vcpresource"
  },
  "sap.platform.cf": {
    "oAuthScopes": [
        "$XSAPPNAME.User",
        "$XSAPPNAME.admin"
    ],
    "ui5VersionNumber": "1.143.2"
}
}
